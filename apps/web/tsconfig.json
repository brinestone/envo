{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@store/*": ["./src/app/stores/*"],
      "@spartan/ui/alert": ["./libs/ui/alert/src/index.ts"],
      "@spartan/ui/button": ["./libs/ui/button/src/index.ts"],
      "@spartan/ui/field": ["./libs/ui/field/src/index.ts"],
      "@spartan/ui/input": ["./libs/ui/input/src/index.ts"],
      "@spartan/ui/label": ["./libs/ui/label/src/index.ts"],
      "@spartan/ui/select": ["./libs/ui/select/src/index.ts"],
      "@spartan/ui/sidebar": ["./libs/ui/sidebar/src/index.ts"],
      "@spartan/ui/sonner": ["./libs/ui/sonner/src/index.ts"],
      "@spartan/ui/spinner": ["./libs/ui/spinner/src/index.ts"],
      "@spartan/ui/utils": ["./libs/ui/utils/src/index.ts"],
      "@spartan/ui/separator": ["./libs/ui/separator/src/index.ts"],
      "@spartan/ui/sheet": ["./libs/ui/sheet/src/index.ts"],
      "@spartan/ui/skeleton": ["./libs/ui/skeleton/src/index.ts"],
      "@spartan/ui/tooltip": ["./libs/ui/tooltip/src/index.ts"],
      "@envo/api/*": ["./libs/api/envo/*"],
      "@libs/auth": ["./libs/auth/index.ts"],
      "@libs/device": ["./libs/device/*"],
      "@spartan/ui/card": ["./libs/ui/card/src/index.ts"],
      "@spartan/ui/checkbox": ["./libs/ui/checkbox/src/index.ts"],
      "@spartan/ui/dropdown-menu": ["./libs/ui/dropdown-menu/src/index.ts"],
      "@spartan/ui/dialog": ["./libs/ui/dialog/src/index.ts"],
      "@spartan/ui/breadcrumb": ["./libs/ui/breadcrumb/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./projects/ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui/tsconfig.spec.json"
    }
  ]
}
