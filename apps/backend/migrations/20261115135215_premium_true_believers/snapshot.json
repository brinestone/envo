    {
      "op": "alter",
      "key": "views\u0000[\"public\",\"vw_project_lookups\"]",
      "set": {
        "definition": "with \"unique_config\" as (select distinct on (\"c\".\"project\", \"c\".\"key\") \"project\", \"key\", \"label\", \"value\", \"created_at\", \"updated_at\", \"version\", \"trace_id\", \"deleted_at\", \"environment\" from \"configs\" \"c\") select \"p\".\"id\", \"p\".\"name\", \"p\".\"image\", \"p\".\"organization\", \"p\".\"created_by\", \"m\".\"user_id\", \"u\".\"name\" as \"creator_name\", \"u\".\"image\" as \"creator_avatar\", count(\"unique_config\".\"key\") as \"config_count\" from \"projects\" \"p\" left join \"unique_config\" on (((\"unique_config\".\"deleted_at\" is null)) and (\"unique_config\".\"project\" = \"p\".\"id\")) left join \"member\" \"m\" on \"m\".\"id\" = \"p\".\"created_by\" left join \"user\" \"u\" on \"u\".\"id\" = \"m\".\"user_id\" group by \"p\".\"id\", \"m\".\"user_id\", \"u\".\"name\", \"u\".\"image\""
      }
